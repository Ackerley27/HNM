APP_ENV=development
DATABASE_URL=postgresql+psycopg://hospital_monitor:change_me@localhost:5432/hospital_monitor
JWT_SECRET_KEY=replace_with_at_least_32_random_bytes
JWT_ACCESS_TOKEN_MINUTES=20
CORS_ORIGINS=["http://localhost:5173"]
MONITORING_MODE=demo
COLLECTOR_INTERVAL_SECONDS=60

# Live mode is read-only. Configure secrets only on the backend host.
# MONITORING_MODE=live
# ZABBIX_API_URL=https://zabbix.example.org
# ZABBIX_API_TOKEN=read_only_api_token
# NTOPNG_API_URL=https://ntopng.example.org:3001
# NTOPNG_USERNAME=readonly_collector
# NTOPNG_PASSWORD=server_only_password
# NTOPNG_INTERFACE_ID=0
# SNMPV3_TARGETS=[{"ip_address":"192.0.2.10","username":"monitor","auth_key":"secret","privacy_key":"secret"}]
# NETFLOW_V5_ENABLED=true
# NETFLOW_V5_HOST=0.0.0.0
# NETFLOW_V5_PORT=2055
# NETFLOW_ALLOWED_EXPORTERS=["192.0.2.250"]
# SYSLOG_ENABLED=true
# SYSLOG_HOST=0.0.0.0
# SYSLOG_PORT=5514
# SYSLOG_ALLOWED_EXPORTERS=["192.0.2.250"]
